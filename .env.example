# Copy this file to .env and replace every placeholder locally.
# Never commit .env or real credentials.

POSTGRES_DB=enterprise_agent
POSTGRES_USER=enterprise_agent
POSTGRES_PASSWORD=replace-with-a-long-random-local-password
POSTGRES_PORT=5433

AGENT_SERVER_PORT=8010
AGENT_SERVER_SESSION_API_KEY=replace-with-a-random-local-session-key
AUTH_SIGNING_KEY=replace-with-a-different-long-random-local-signing-key

# Stage 0 uses Mock LLM only. Do not add paid API keys here.
LLM_MODEL=mock
